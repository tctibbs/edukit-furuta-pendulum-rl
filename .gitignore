# Third-party reference documents, copyright ST and UCLA. Not redistributable.
# Repopulate with scripts/fetch_reference_docs.sh
docs/reference/*
!docs/reference/.gitkeep

# Local tooling and machine-specific notes
.claude

# Third-party source trees, extracted locally. Not redistributable. `firmware/` is the
# stock Edukit source this project's modes are built from; it carries no LICENSE, so it
# is never committed. See .claude/rules/publishing.md.
vendor/
firmware/

# Firmware images and other build output, including the mode images
# docs/runbooks/edukit-firmware.md stages under build/firmware/.
build/

# Bench captures, written by the hw-* recipes. The ones a write-up cites are copied into
# its experiment folder.
data/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# OS
.DS_Store
